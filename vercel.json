{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/SinglePlayer/arrowparty/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)cocos2d-js-min.06694.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)s.25896.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/SinglePlayer/arrowparty", "destination": "/" },
    { "source": "/SinglePlayer/arrowparty/", "destination": "/" },
    { "source": "/SinglePlayer/arrowparty/:path*", "destination": "/:path*" },
    { "source": "/SinglePlayer/src/:path*", "destination": "/:path*" },
    { "source": "/SinglePlayer/:path*", "destination": "/:path*" }
  ]
}
